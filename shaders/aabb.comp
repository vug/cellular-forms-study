#version 460
// The bounding box of every cell (a sphere of the drawn radius), for the acceleration structure
// that the ray-traced modes trace against.
layout(local_size_x = 256) in;

layout(set = 1, binding = 1, std430) readonly buffer CellPos { float cellPos[]; };  // 3 per cell
layout(set = 1, binding = 5, std430) writeonly buffer Boxes { float box[]; };       // 6 per cell: min, max

layout(push_constant) uniform Push {
    uint count;
    float radius;
} P;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= P.count) return;
    vec3 c = vec3(cellPos[3u * i], cellPos[3u * i + 1u], cellPos[3u * i + 2u]);
    box[6u * i] = c.x - P.radius;
    box[6u * i + 1u] = c.y - P.radius;
    box[6u * i + 2u] = c.z - P.radius;
    box[6u * i + 3u] = c.x + P.radius;
    box[6u * i + 4u] = c.y + P.radius;
    box[6u * i + 5u] = c.z + P.radius;
}
